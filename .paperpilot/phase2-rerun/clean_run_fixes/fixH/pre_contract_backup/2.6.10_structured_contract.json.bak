  "api_endpoints": [
    {
      "path": "collections+create",
      "method": "POST",
      "category": "collections",
      "description": "Create a new collection with schema or quick-setup parameters",
      "source_url": "https://milvus.io/api-reference/restful/v2.6.x/v2/Collection%20(v2)/Create.md",
      "doc_version": "2.6.x",
      "parameters": [
        {
          "name": "collectionName",
          "type": "string",
          "required": true,
          "description": "Name of the collection"
        },
        {
          "name": "dbName",
          "type": "string",
          "required": false,
          "description": "Name of the database",
          "default_value": "_default"
        },
        {
          "name": "dimension",
          "type": "integer",
          "required": false,
          "description": "Number of vector dimensions (quick-setup mode, ignored if schema provided)"
        },
        {
          "name": "metricType",
          "type": "string",
          "required": false,
          "description": "Similarity metric: L2, IP, COSINE",
          "enum_values": [
            "L2",
            "IP",
            "COSINE"
          ]
        },
        {
          "name": "idType",
          "type": "string",
          "required": false,
          "description": "Primary field type: Int64 or VarChar",
          "enum_values": [
            "Int64",
            "VarChar"
          ]
        },
        {
          "name": "autoID",
          "type": "boolean",
          "required": false,
          "description": "Auto-increment primary key"
        },
        {
          "name": "primaryFieldName",
          "type": "string",
          "required": false,
          "description": "Custom name for primary field"
        },
        {
          "name": "vectorFieldName",
          "type": "string",
          "required": false,
          "description": "Custom name for vector field"
        },
        {
          "name": "enableDynamicField",
          "type": "boolean",
          "required": false,
          "description": "Enable reserved $meta dynamic field"
        },
        {
          "name": "shardsNum",
          "type": "integer",
          "required": false,
          "description": "Number of shards",
          "default_value": 1
        },
        {
          "name": "consistencyLevel",
          "type": "string",
          "required": false,
          "description": "Consistency level",
          "enum_values": [
            "Strong",
            "Session",
            "Bounded",
            "Eventually"
          ]
        },
        {
          "name": "partitionsNum",
          "type": "integer",
          "required": false,
          "description": "Number of partitions"
        },
        {
          "name": "ttlSeconds",
          "type": "integer",
          "required": false,
          "description": "Time-to-live in seconds"
        },
        {
          "name": "params",
          "type": "object",
          "required": false,
          "description": "Extra collection parameters"
        },
        {
          "name": "schema",
          "type": "object",
          "required": false,
          "description": "Explicit schema definition (overrides quick-setup params)"
        },
        {
          "name": "indexParams",
          "type": "array",
          "required": false,
          "description": "Index parameters for quick-setup"
        }
      ]
    },
