  "behavioral_contracts": [
    {
      "contract_id": "milvus_behavioral_create_query_visibility_001",
      "description": "After creating a collection, it should be immediately visible via list and describe operations",
      "scenario": "Create collection -> List collections -> Describe collection",
      "expected_behavior": "A newly created collection appears in list results and can be described successfully with 200",
      "related_endpoints": [
        "collections+create",
        "collections+list",
        "collections+describe"
      ],
      "source_url": "https://milvus.io/api-reference/restful/v2.6.x/v2/Collection%20(v2)/Create.md"
    },
    {
      "contract_id": "milvus_behavioral_insert_query_consistency_001",
      "description": "After inserting entities, query with filter should return the inserted entities (bounded consistency)",
      "scenario": "Insert N entities -> Query with filter matching inserted entities",
      "expected_behavior": "Query returns the inserted entities within consistency guarantees (bounded eventually consistent)",
      "related_endpoints": [
        "entities+insert",
        "entities+query",
        "entities+get"
      ],
      "source_url": "https://github.com/milvus-io/milvus/blob/v2.6.17/internal/distributed/proxy/httpserver/constant.go"
    },
    {
      "contract_id": "milvus_behavioral_drop_query_invisibility_001",
      "description": "After dropping a collection, it should no longer be visible in list results",
      "scenario": "Drop collection -> List collections -> Has collection",
      "expected_behavior": "Dropped collection no longer appears in list results; Has collection returns false; Describe returns 404",
      "related_endpoints": [
        "collections+drop",
        "collections+list",
        "collections+has",
        "collections+describe"
      ],
      "source_url": "https://milvus.io/api-reference/restful/v2.6.x/v2/Collection%20(v2)/Drop.md"
    },
    {
      "contract_id": "milvus_behavioral_upsert_atomicity_001",
      "description": "Upsert should atomically insert or update an entity",
      "scenario": "Insert entity -> Upsert with same PK and different field values -> Query by PK",
      "expected_behavior": "Query returns entity with updated field values, not the original; insertCount reflects upsert behavior",
      "related_endpoints": [
        "entities+upsert",
        "entities+insert",
        "entities+query"
      ],
      "source_url": "https://github.com/milvus-io/milvus/blob/v2.6.17/internal/distributed/proxy/httpserver/constant.go"
    }
  ],
  "state_invariants": [
    {
      "invariant_id": "milvus_invariant_create_queryable_001",
      "description": "After a collection is created, it must be describable and appear in the collection list",
      "assertion": "create(collection) -> describe(collection) must return 200 AND list() must contain collectionName",
      "scope": "per_collection",
      "source_url": "https://milvus.io/api-reference/restful/v2.6.x/v2/Collection%20(v2)/Create.md"
    },
    {
      "invariant_id": "milvus_invariant_drop_nonexistent_001",
      "description": "After a collection is dropped, it must not exist and describe must return 404",
      "assertion": "drop(collection) -> describe(collection) must return 404 AND has(collection) must return false",
      "scope": "per_collection",
      "source_url": "https://milvus.io/api-reference/restful/v2.6.x/v2/Collection%20(v2)/Drop.md"
    },
    {
      "invariant_id": "milvus_invariant_count_consistency_001",
      "description": "After inserting N entities, get_stats must report rowCount >= N",
      "assertion": "insert(N entities) -> get_stats().rowCount >= N",
      "scope": "per_collection",
      "source_url": "https://github.com/milvus-io/milvus/blob/v2.6.17/internal/distributed/proxy/httpserver/constant.go"
    },
    {
      "invariant_id": "milvus_invariant_delete_count_001",
      "description": "After deleting entities matching a filter, get_stats rowCount must decrease by the number of deleted entities",
      "assertion": "delete(filter) -> get_stats().rowCount == previous_rowCount - deleted_count",
      "scope": "per_collection",
      "source_url": "https://github.com/milvus-io/milvus/blob/v2.6.17/internal/distributed/proxy/httpserver/constant.go"
    },
    {
      "invariant_id": "milvus_invariant_load_state_001",
      "description": "After successfully loading a collection, get_load_state must report Loaded",
      "assertion": "load(collection) -> get_load_state(collection).loadState == 'LoadStateLoaded'",
      "scope": "per_collection",
      "source_url": "https://milvus.io/api-reference/restful/v2.6.x/v2/Collection%20(v2)/Load.md"
    },
    {
      "invariant_id": "milvus_invariant_create_duplicate_001",
      "description": "Idempotent collection creation: re-creating an existing collection with the SAME schema succeeds (HTTP 200, no-op); re-creating with DIFFERENT parameters returns an error",
      "assertion": "create(collection, schema A) -> create(collection, schema A) returns 200 (idempotent no-op); create(collection, schema B != A) returns error",
      "scope": "per_collection",
      "source_url": "https://milvus.io/api-reference/restful/v2.6.x/v2/Collection%20(v2)/Create.md"
    }
  ],
